+// 电控弹速接收状态：把"收没收到"做成一眼可辨的三态。
+// 只看 bullet_speed 数值是不够的 —— 收不到时它是构造函数里的默认值 11，
+// 和真实弹速长得一模一样，所以这里额外用接收计数 + 时间戳来判定。
+struct BulletSpeedStatus
+{
+  bool ok = false;  // 正在稳定收到
+  bool stale = false;  // 收到过，但最近断了
+  std::string text;   // 三态文字
+  std::string detail;  // 第一行定位信息
+  std::string detail2;  // 第二行：原始字节 / 各种解法（收不到时才有）
+  std::string short_detail;  // 面板里用的一行摘要
+  std::string value_suffix;  // 跟在数值后面的说明：真值 / 默认值 / 跳变值
+  cv::Scalar color;
+};
+
+// 把 data[offset..offset+1] 按指定字节序解成 int16，并给出它对应多少 m/s。
+// 纯显示用，顺序和 CBoard::decode_bullet_speed() 保持一致（×1 / ×10 / ×100）。
+std::string describe_bytes(
+  const std::array<unsigned char, 8> & b, int dlc, int offset, bool little_endian)
+{
+  if (offset < 0 || offset > 6) return "--";
+  if (dlc > 0 && offset + 1 >= dlc) return fmt::format("data[{}..{}] beyond dlc={}", offset,
+                                                       offset + 1, dlc);
+
+  const auto hi = static_cast<std::uint16_t>(b[static_cast<std::size_t>(offset)]);
+  const auto lo = static_cast<std::uint16_t>(b[static_cast<std::size_t>(offset + 1)]);
+  const auto raw_u = little_endian ? static_cast<std::uint16_t>(hi | (lo << 8))
+                                   : static_cast<std::uint16_t>((hi << 8) | lo);
+  const auto raw = static_cast<int16_t>(raw_u);
+
+  const std::string tag = fmt::format("0x{:04X}={}", static_cast<unsigned>(raw_u),
+                                      static_cast<int>(raw));
+  const double scales[3] = {1.0, 10.0, 100.0};
+  for (const double sc : scales) {
+    const double v = static_cast<double>(raw) / sc;
+    if (v >= 8.0 && v <= 30.0) {
+      return fmt::format("{} -> {:.1f} m/s (x{:.0f})", tag, v, sc);
+    }
+  }
+  return fmt::format("{} -> not a speed", tag);
+}
+
+std::string hex_dump(const std::array<unsigned char, 8> & b, int dlc)
+{
+  std::string out;
+  for (int i = 0; i < 8; ++i) {
+    if (dlc > 0 && i >= dlc) {
+      out += "-- ";
+    } else {
+      out += fmt::format("{:02X} ", b[static_cast<std::size_t>(i)]);
+    }
+  }
+  return out;
+}
+
+BulletSpeedStatus make_bullet_speed_status(const DebugOverlayInput & input)
+{
+  const auto & rx = input.bullet_speed_rx;
+  const int offset = rx.byte_offset >= 0 ? rx.byte_offset : 6;
+  BulletSpeedStatus s;
+
+  // 0x106 一般几百 Hz，超过 0.5s 没更新就认为断了。
+  constexpr double fresh_s = 0.5;
+  const bool fresh = rx.ever_received && rx.age_s >= 0.0 && rx.age_s <= fresh_s;
+  // 光"这一帧能解出数"不够：弹速是缓变的，必须连续好几帧解出来都一样才算真收到。
+  // 如果值一直在跳（stable 很小），说明这两字节根本不是弹速，
+  // 只是偶尔撞进 8~30 的判定窗口 —— 表现就是"一会儿收到一会儿收不到"。
+  constexpr std::uint32_t stable_needed = 5;
+  s.ok = fresh && rx.stable_frames >= stable_needed;
+  s.stale = rx.ever_received && !fresh;
+
+  if (s.ok) {
+    s.text = "RX OK";
+    s.value_suffix = "   <- from EC";
+    s.color = cv::Scalar(0, 255, 0);  // 绿：正在稳定收到
+  } else if (fresh) {
+    s.text = "UNSTABLE";
+    s.value_suffix = "   (flapping, NOT from EC)";
+    s.color = cv::Scalar(0, 165, 255);  // 橙：能解出数但值在跳，不是弹速
+  } else if (s.stale) {
+    s.text = fmt::format("RX LOST {:.1f}s", rx.age_s);
+    s.value_suffix = "   (stale, last known)";
+    s.color = cv::Scalar(0, 165, 255);  // 橙：以前有，现在断了
+  } else {
+    s.text = "NOT RECEIVED";
+    s.value_suffix = "   (DEFAULT 11.0, NOT from EC)";
+    s.color = cv::Scalar(0, 0, 255);  // 红：从来没收到过
+  }
+
+  // 两个频率放一起看最有用：
+  //   0x106 Hz = 电控发过来的帧率（链路在不在、发多快）
+  //   speed Hz = 其中有几帧真的带着能认出来的弹速
+  // 两者相等 -> 每帧都带弹速；0x106 高而 speed 低 -> 帧在发但这两字节不是弹速。
+  s.short_detail = fmt::format(
+    "0x106 {:.0f}Hz / speed {:.0f}Hz  raw[{}] n={}", rx.motor_hz, rx.hz,
+    fmt::format("{}..{}", static_cast<int>(rx.raw_min), static_cast<int>(rx.raw_max)), rx.count);
+
+  // 这两字节的取值范围是最硬的证据：真弹速范围很窄，计数器之类的会铺满整个范围。
+  const std::string range_text = fmt::format(
+    "raw[{}..{}]", static_cast<int>(rx.raw_min), static_cast<int>(rx.raw_max));
+
+  if (s.ok) {
+    // 收到时把"从哪两个字节、按什么字节序、什么量纲解出来的"标清楚，
+    // 免得看到一个数字却不知道它可不可信。
+    s.detail = fmt::format(
+      "raw={} = {:.2f} m/s  [data[{}..{}] {} x{:.0f}]   stable {} frames  {:.2f}s ago",
+      static_cast<int>(rx.speed_raw), input.bullet_speed, offset, offset + 1,
+      rx.little_endian ? "LE" : "BE", rx.scale, rx.stable_frames, rx.age_s);
+    s.detail2 = fmt::format(
+      "0x106 {:.1f}Hz -> speed {:.1f}Hz   {}   dlc={}  bytes: {}", rx.motor_hz, rx.hz, range_text,
+      rx.frame_dlc, hex_dump(rx.frame_bytes, rx.frame_dlc));
+  } else if (fresh) {
+    // 能解出数但一直在跳：基本可以断定这两字节不是弹速。
+    s.detail = fmt::format(
+      "value keeps changing (stable {} frames) -> data[{}..{}] is NOT a bullet speed field",
+      rx.stable_frames, offset, offset + 1);
+    s.detail2 = fmt::format(
+      "0x106 {:.1f}Hz, speed matched {:.1f}Hz, {}   bytes: {}", rx.motor_hz, rx.hz, range_text,
+      hex_dump(rx.frame_bytes, rx.frame_dlc));
+  } else if (rx.have_frame) {
+    // CAN 通着、0x106 在收，只是这两字节没被认成弹速 —— 把原始内容摊开，
+    // 直接看电控填了什么、是量纲不对还是字节序不对。
+    s.detail = fmt::format(
+      "0x106 {:.1f}Hz (n={}, {:.2f}s ago, dlc={}) but data[{}..{}] not recognised as a speed",
+      rx.motor_hz, rx.motor_frames, rx.motor_age_s, rx.frame_dlc, offset, offset + 1);
+    s.detail2 = fmt::format(
+      "{}   bytes: {}  |  BE {}  |  LE {}", range_text, hex_dump(rx.frame_bytes, rx.frame_dlc),
+      describe_bytes(rx.frame_bytes, rx.frame_dlc, offset, false),
+      describe_bytes(rx.frame_bytes, rx.frame_dlc, offset, true));
+  } else {
+    s.detail = "no 0x106 frame at all: check motor_angle_canid / CAN link / EC power";
+  }
+
+  return s;
+}
