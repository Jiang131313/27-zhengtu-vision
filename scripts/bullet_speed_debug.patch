+// 连续多少帧解出的弹速基本一致，才认定这是真弹速（而不是偶尔撞进窗口的杂数据）。
+constexpr std::uint32_t kStableFramesNeeded = 5;
+
+std::int64_t steady_now_ns()
+{
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+           std::chrono::steady_clock::now().time_since_epoch())
+    .count();
+}
+
+// 2 秒滑动窗口算频率：窗口没满就沿用上次算出来的值。
+// 只在 CAN 回调线程调用，所以窗口状态本身不用加锁。
+double update_rate_hz(
+  std::atomic<std::int64_t> & win_ns, std::atomic<std::uint32_t> & win_base, std::uint32_t count,
+  std::int64_t now_ns, double previous_hz)
+{
+  const auto win = win_ns.load(std::memory_order_relaxed);
+  if (win == 0) {
+    win_ns.store(now_ns, std::memory_order_relaxed);
+    win_base.store(count, std::memory_order_relaxed);
+    return previous_hz;
+  }
+  if (now_ns - win < 2000000000LL) return previous_hz;
+
+  const auto base = win_base.load(std::memory_order_relaxed);
+  const auto span = static_cast<double>(now_ns - win);
+  const double hz =
+    span > 0.0 ? static_cast<double>(count - base) * 1e9 / span : previous_hz;
+  win_ns.store(now_ns, std::memory_order_relaxed);
+  win_base.store(count, std::memory_order_relaxed);
+  return hz;
+}
+
+// 把 data[offset..offset+1] 解成 int16，再按 ×1 / ×10 / ×100 三种量纲试出弹速。
+// 三种量纲对应原始值区间互不重叠（8~30 / 80~300 / 800~3000），所以不会有歧义。
+// 大端小端都试：电控用 memcpy 直接把 int16 写进 CAN 帧就会变成小端。
+struct SpeedDecode
+{
+  double speed = -1.0;  // <0 表示这两字节不是弹速
+  double raw = 0.0;     // 原始 int16（按解出结果的那种字节序）
+  double scale = 0.0;   // 1 / 10 / 100
+};
+
+SpeedDecode decode_bullet_speed(const unsigned char * data, int offset, bool little_endian)
+{
+  SpeedDecode out;
+  if (offset < 0 || offset > 6) return out;
+
+  const auto hi = static_cast<std::uint16_t>(data[offset]);
+  const auto lo = static_cast<std::uint16_t>(data[offset + 1]);
+  const auto raw_u = little_endian ? static_cast<std::uint16_t>(hi | (lo << 8))
+                                   : static_cast<std::uint16_t>((hi << 8) | lo);
+  const auto raw = static_cast<int16_t>(raw_u);
+
+  out.raw = static_cast<double>(raw);
+  // 依次按 ×1 / ×10 / ×100 试，落在 8~30 m/s 就认。
+  const double scales[3] = {1.0, 10.0, 100.0};
+  for (const double s : scales) {
+    const double v = static_cast<double>(raw) / s;
+    if (v >= 8.0 && v <= 30.0) {
+      out.speed = v;
+      out.scale = s;
+      return out;
+    }
+  }
+  return out;
+}
+}  // namespace
+
+// 记一次「有效弹速」：只有解析结果落在合理弹速区间才会走到这里。
+// 调试窗口就靠这里的计数/时间戳区分「电控在发弹速」和「没收到、在用默认值」。
+void CBoard::note_bullet_speed(
+  double speed, double raw, int canid, int byte_offset, bool little_endian, double scale)
+{
+  const auto now_ns = steady_now_ns();
+
+  bullet_speed_rx_ns_.store(now_ns, std::memory_order_relaxed);
+  bullet_speed_speed_raw_.store(raw, std::memory_order_relaxed);
+  bullet_speed_src_canid_.store(canid, std::memory_order_relaxed);
+  bullet_speed_byte_offset_used_.store(byte_offset, std::memory_order_relaxed);
+  bullet_speed_little_endian_used_.store(little_endian ? 1 : 0, std::memory_order_relaxed);
+  bullet_speed_scale_used_.store(scale, std::memory_order_relaxed);
+  const auto count = bullet_speed_rx_count_.fetch_add(1, std::memory_order_relaxed) + 1;
+
+  // 约 2 秒滑窗统计接收频率：能看出是稳定在发还是断续丢帧。
+  bullet_speed_rx_hz_.store(
+    update_rate_hz(
+      bullet_speed_win_ns_, bullet_speed_win_base_, count, now_ns,
+      bullet_speed_rx_hz_.load(std::memory_order_relaxed)),
+    std::memory_order_relaxed);
+
+  // 1Hz 打印：把量纲和字节序一起打出来，方便跟电控对协议。
+  static auto last_log = std::chrono::steady_clock::time_point::min();
+  const auto now = std::chrono::steady_clock::now();
+  if (
+    last_log == std::chrono::steady_clock::time_point::min() ||
+    std::chrono::duration<double>(now - last_log).count() >= 1.0) {
+    last_log = now;
+    tools::logger()->info(
+      "[CBoard] bullet_speed RX: raw={} -> {:.2f} m/s (from 0x{:X}, data[{}..{}], {}, x{:.0f})",
+      static_cast<int>(raw), speed, canid, byte_offset, byte_offset + 1,
+      little_endian ? "little-endian" : "big-endian", scale);
+  }
+}
+
+// 收到一帧 0x106：先统计帧本身（证明 CAN 链路和电机姿态是通的），
+// 再解析弹速。yaw/pitch 占了 data[0..3]，弹速在 data[6..7]。
+void CBoard::note_motor_frame(const can_frame & frame)
+{
+  const auto now_ns = steady_now_ns();
+
+  motor_frame_ns_.store(now_ns, std::memory_order_relaxed);
+  const auto frame_count = motor_frame_count_.fetch_add(1, std::memory_order_relaxed) + 1;
+  motor_frame_dlc_.store(static_cast<int>(frame.can_dlc), std::memory_order_relaxed);
+
+  // 0x106 的真实接收频率：电控发多快就是多快，用来和弹速的识别频率对比。
+  motor_frame_hz_.store(
+    update_rate_hz(
+      motor_frame_win_ns_, motor_frame_win_base_, frame_count, now_ns,
+      motor_frame_hz_.load(std::memory_order_relaxed)),
+    std::memory_order_relaxed);
+
+  // 整帧打包成一个 u64 存下来（无锁），窗口那边再拆开显示。
+  std::uint64_t packed = 0;
+  for (int i = 0; i < 8; ++i) {
+    packed |= static_cast<std::uint64_t>(frame.data[i]) << (8 * i);
+  }
+  motor_frame_packed_.store(packed, std::memory_order_relaxed);
+
+  const int offset =
+    (bullet_speed_byte_offset_ >= 0 && bullet_speed_byte_offset_ <= 6) ? bullet_speed_byte_offset_
+                                                                      : 6;
+
+  // ---- 证据 1：这两字节在最近 2s 内的取值范围 ----
+  // 真弹速缓变 -> 范围很窄；计数器之类的遥测 -> 范围很宽。
+  {
+    const int16_t raw_be = static_cast<int16_t>((frame.data[offset] << 8) | frame.data[offset + 1]);
+    const auto raw_win = motor_raw_win_ns_.load(std::memory_order_relaxed);
+    if (raw_win == 0 || now_ns - raw_win >= 2000000000LL) {
+      motor_raw_win_ns_.store(now_ns, std::memory_order_relaxed);
+      motor_raw_min_.store(raw_be, std::memory_order_relaxed);
+      motor_raw_max_.store(raw_be, std::memory_order_relaxed);
+    } else {
+      if (raw_be < motor_raw_min_.load(std::memory_order_relaxed)) {
+        motor_raw_min_.store(raw_be, std::memory_order_relaxed);
+      }
+      if (raw_be > motor_raw_max_.load(std::memory_order_relaxed)) {
+        motor_raw_max_.store(raw_be, std::memory_order_relaxed);
+      }
+    }
+  }
+
+  // 先按大端解（跟 yaw/pitch 一致）；解不出来再试小端。
+  SpeedDecode dec = decode_bullet_speed(frame.data, offset, false);
+  bool little_endian = false;
+  if (dec.speed < 0.0) {
+    const SpeedDecode le = decode_bullet_speed(frame.data, offset, true);
+    if (le.speed > 0.0) {
+      dec = le;
+      little_endian = true;
+    }
+  }
+
+  // ---- 证据 2：连续同值帧数 ----
+  // 弹速是缓变的，连续帧解出来应该基本一样。如果值忽大忽小，说明这两字节
+  // 不是弹速，只是偶尔撞进 8~30 的判定窗口 —— 这就会表现为"一会儿收到一会儿收不到"。
+  if (dec.speed < 0.0) {
+    stable_speed_frames_.store(0, std::memory_order_relaxed);
+    stable_speed_value_.store(0.0, std::memory_order_relaxed);
+    return;  // 这两字节不是弹速，只记帧、不动 bullet_speed
+  }
+  const double prev = stable_speed_value_.load(std::memory_order_relaxed);
+  std::uint32_t stable = 1;
+  if (prev > 0.0 && std::abs(dec.speed - prev) <= 1.0) {
+    stable = stable_speed_frames_.fetch_add(1, std::memory_order_relaxed) + 1;
+  } else {
+    stable_speed_value_.store(dec.speed, std::memory_order_relaxed);
+    stable_speed_frames_.store(1, std::memory_order_relaxed);
+  }
+
+  // 只有连续 kStableFramesNeeded 帧解出来基本一致，才敢当成真弹速用。
+  // 乱跳的帧只记账、不写 bullet_speed —— 否则一次误判就会让弹道解算跟着跳。
+  if (stable >= kStableFramesNeeded) bullet_speed = dec.speed;
+
+  // 不管稳不稳都记一笔接收状态，窗口才能区分"断链"和"值在跳"。
+  note_bullet_speed(dec.speed, dec.raw, motor_angle_canid_, offset, little_endian, dec.scale);
+}
+
+CBoard::BulletSpeedRx CBoard::bullet_speed_rx() const
+{
+  const auto now_ns = steady_now_ns();
+
+  BulletSpeedRx rx;
+  rx.count = bullet_speed_rx_count_.load(std::memory_order_relaxed);
+  rx.ever_received = rx.count > 0;
+  rx.hz = bullet_speed_rx_hz_.load(std::memory_order_relaxed);
+  rx.speed_raw = bullet_speed_speed_raw_.load(std::memory_order_relaxed);
+  rx.src_canid = bullet_speed_src_canid_.load(std::memory_order_relaxed);
+  rx.byte_offset = bullet_speed_byte_offset_used_.load(std::memory_order_relaxed);
+  rx.little_endian = bullet_speed_little_endian_used_.load(std::memory_order_relaxed) != 0;
+  rx.scale = bullet_speed_scale_used_.load(std::memory_order_relaxed);
+  rx.motor_frames = motor_frame_count_.load(std::memory_order_relaxed);
+  rx.motor_hz = motor_frame_hz_.load(std::memory_order_relaxed);
+  rx.raw_min = motor_raw_min_.load(std::memory_order_relaxed);
+  rx.raw_max = motor_raw_max_.load(std::memory_order_relaxed);
+  rx.stable_frames = stable_speed_frames_.load(std::memory_order_relaxed);
+  rx.frame_dlc = motor_frame_dlc_.load(std::memory_order_relaxed);
+  rx.have_frame = rx.motor_frames > 0;
+
+  // 拆出最近一帧 0x106 的原始 8 字节，窗口那边直接显示。
+  const auto packed = motor_frame_packed_.load(std::memory_order_relaxed);
+  for (int i = 0; i < 8; ++i) {
+    rx.frame_bytes[static_cast<std::size_t>(i)] =
+      static_cast<unsigned char>((packed >> (8 * i)) & 0xFF);
+  }
+
+  const auto rx_ns = bullet_speed_rx_ns_.load(std::memory_order_relaxed);
+  if (rx.ever_received && rx_ns > 0) {
+    rx.age_s = static_cast<double>(now_ns - rx_ns) / 1e9;
+  }
+
+  const auto motor_ns = motor_frame_ns_.load(std::memory_order_relaxed);
+  if (rx.motor_frames > 0 && motor_ns > 0) {
+    rx.motor_age_s = static_cast<double>(now_ns - motor_ns) / 1e9;
+  }
+
+  return rx;
+}
